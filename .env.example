# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8080
NODE_ENV=development

# Exact origin of the Vite dev server / production client, no trailing slash.
# Used for CORS. Dev default: http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (1 on Render/Railway/Fly).
# Required for IP rate limiting to see the real client IP. Set 0 locally.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/already-exists
# Case files are kept 90 days; Mongo TTL index enforces expires_at.

# ---------------------------------------------------------------------------
# LLM (swappable). LLM_PROVIDER=gemini | groq
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Evidence sources
# ---------------------------------------------------------------------------
# GitHub repo search. REQUIRED for the GitHub adapter; unauthenticated search
# is limited to 10 req/min and is shared per IP, so we skip it without a token.
GITHUB_TOKEN=

# Web search. Tavily is primary. Brave is the optional fallback when
# TAVILY_API_KEY is absent.
TAVILY_API_KEY=
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Spike only — optional overrides for `npm run spike`
# ---------------------------------------------------------------------------
# Grounds the LLM calls in the spike. Any real product idea.
SPIKE_IDEA=
